        },
        "builtInTools": {},
        "options": {}
      },
      "id": "20c70eb3-472d-4b8a-8ca4-6236cb8fb3f5",
      "name": "Writer Chat Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1.3,
