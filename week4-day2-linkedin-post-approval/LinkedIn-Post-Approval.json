      "id": "a5b94f7e-6388-4051-a7fc-cb0494de1bec",
      "name": "Reviewer Chat Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1.3,
      "position": [
        80,
        176
      ]
    },
    {
      "parameters": {
        "jsCode": "const post=String($json.output ?? '').trim(); const topic=String($('On form submission').first().json.Topic ?? '').trim(); const words=post.split(/\\s+/).filter(Boolean).length; if(!topic || !post) throw new Error('Topic or reviewed post is empty'); if(words<120 || words>150) throw new Error('Reviewed post must contain 120-150 words; got '+words); if((post.match(/(^|\\s)#[\\p{L}\\p{N}_]+/gu)||[]).length>3) throw new Error('More than 3 hashtags'); return [{json:{Topic:topic,'Final Post':post,wordCount:words}}];"
      },
      "id": "4975b160-b0a8-4549-9edf-17be63718cad",
      "name": "Prepare approval",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        368,
        -80
      ]
    },
    {
      "parameters": {
        "operation": "sendAndWait",
        "sendTo": "YOUR_EMAIL_ADDRESS",
        "subject": "=LinkedIn post approval: {{ $json.Topic }}",
        "message": "=Topic: {{ $json.Topic }}\n\n{{ $json[\"Final Post\"] }}\n\nChoose Approve to save this post to Google Sheets. Reject saves nothing. This request expires after one day.",
        "approvalOptions": {
          "values": {
            "approvalType": "double",
            "disapproveLabel": "Reject"
          }
        },
        "options": {
          "limitWaitTime": {
            "values": {
              "resumeUnit": "days"
            }
          },
          "appendAttribution": false
        }
      },
      "id": "d5f752c8-a11f-487d-bb32-eee25b35abb7",
      "name": "Email approval and wait",
